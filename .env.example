DISCORD_TOKEN=
GUILD_ID=
ENVIRONMENT=development
LOG_LEVEL=INFO
NETWORK_LOG_LEVEL=INFO
ENABLE_NETWORK_ACCESS_LOG=true
DISCORD_INTERACTION_ACK_SECONDS=2.5
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_REQUEST_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
POSTGRES_DB=copenhague
POSTGRES_USER=copenhague
POSTGRES_PASSWORD=copenhague
POSTGRES_PORT=5432
POSTGRES_SCHEMA=copenhague
POSTGRES_DSN=postgresql://copenhague:copenhague@postgres:5432/copenhague
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
# 7000 bps = 70% do limite diario de lucro.
ECONOMIC_DIFFICULTY_THRESHOLD_BPS=7000
ENABLE_MEMBERS_INTENT=false
ENABLE_MESSAGE_CONTENT_INTENT=false

# MLBB Public Data API (API comunitaria e nao oficial)
MLBB_ENABLED=false
MLBB_API_BASE_URL=https://mlbb.rone.dev/api
MLBB_HTTP_TIMEOUT_SECONDS=15
MLBB_MAX_CONCURRENT_REQUESTS=10
MLBB_TOKEN_ENCRYPTION_KEYS=
MLBB_AUTH_TTL_SECONDS=300
MLBB_SEND_VC_COOLDOWN_SECONDS=60
MLBB_MAX_CONFIRM_ATTEMPTS=5
MLBB_PROFILE_CACHE_TTL_SECONDS=300
MLBB_STATS_CACHE_TTL_SECONDS=120
MLBB_PROFILE_REFRESH_COOLDOWN_SECONDS=30
